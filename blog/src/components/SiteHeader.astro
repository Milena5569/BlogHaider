---
const navItems = [
  { label: "Categorias", href: "/categoria/fisica" },
  { label: "Tags", href: "/tag/genio" },
  { label: "Autores", href: "/autor/albert" },
  { label: "Trilhas", href: "/trilhas" },
];

const socials = [
  { label: "in", href: "#" },
  { label: "x", href: "#" },
  { label: "f", href: "#" },
];
---

<header class="site-header">
  <div class="site-header__inner container">
    <a href="/" class="site-header__brand editorial-title">VivaTDAH</a>

    <nav class="site-header__nav" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a href={item.href} class="nav-pill site-header__nav-link">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__socials" aria-label="Redes sociais">
      {socials.map((item) => (
        <a href={item.href} class="site-header__social-link" aria-label={item.label}>
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(8, 6, 12, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .site-header__inner {
    min-height: var(--header-height);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }

  .site-header__brand {
    font-size: clamp(2rem, 3vw, 3.2rem);
    line-height: 1;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    justify-self: start;
    transition:
      transform var(--transition-fast),
      color var(--transition-fast);
  }

  .site-header__brand:hover {
    transform: scale(1.02);
    color: var(--lilac-soft);
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .site-header__nav-link {
    min-height: 38px;
    padding: 0 16px;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .site-header__socials {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
  }

  .site-header__social-link {
    color: var(--text);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.2rem;
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      color var(--transition-fast),
      opacity var(--transition-fast);
  }

  .site-header__social-link:hover {
    transform: scale(1.12);
    color: var(--lilac);
  }

  @media (max-width: 980px) {
    .site-header__inner {
      grid-template-columns: 1fr;
      padding-block: 14px;
    }

    .site-header__brand,
    .site-header__nav,
    .site-header__socials {
      justify-self: center;
    }
  }

  @media (max-width: 640px) {
    .site-header__brand {
      font-size: 2.3rem;
    }

    .site-header__nav-link {
      font-size: 0.82rem;
      padding: 0 10px;
      min-height: 32px;
    }

    .site-header__socials {
      gap: 12px;
    }
  }
</style>