---
interface Props {
  title?: string;
  subtitle?: string;
  date?: string;
  badgeText?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = "TDAH",
  subtitle = "Entender o caos mental, a sobrecarga diária e os caminhos práticos para viver com mais clareza.",
  date = "Publicado recentemente",
  badgeText = "destaque editorial",
  ctaLabel = "Ler última publicação",
  ctaHref = "/",
} = Astro.props;
---

<section class="hero-editorial">
  <div class="hero-editorial__bg-gradient"></div>
  <div class="hero-editorial__bg-grid"></div>

  <div class="hero-editorial__blob hero-editorial__blob--left"></div>
  <div class="hero-editorial__blob hero-editorial__blob--top-right"></div>
  <div class="hero-editorial__blob hero-editorial__blob--bottom-right"></div>

  <div class="hero-editorial__inner container">
    <div class="hero-editorial__content">
      <div class="hero-editorial__badge">
        {badgeText}
      </div>

      <h1 class="hero-editorial__title editorial-title">
        {title}
      </h1>

      <p class="hero-editorial__subtitle editorial-subtitle">
        {subtitle}
      </p>

      <p class="hero-editorial__meta">{date}</p>

      <div class="hero-editorial__actions">
        <a href={ctaHref} class="hero-editorial__cta button-editorial">
          {ctaLabel}
        </a>
      </div>
    </div>

    <div class="hero-editorial__art" aria-hidden="true">
      <div class="hero-editorial__clock float-slow">
        <div class="hero-editorial__clock-face"></div>
        <div class="hero-editorial__clock-hand hero-editorial__clock-hand--horizontal"></div>
        <div class="hero-editorial__clock-hand hero-editorial__clock-hand--diagonal"></div>
      </div>

      <div class="hero-editorial__cloud float-medium">
        ☁
      </div>

      <div class="hero-editorial__icons float-soft">
        <div class="hero-editorial__icons-grid">
          <span>♪</span>
          <span>☕</span>
          <span>✦</span>
          <span>✎</span>
          <span>☾</span>
          <span>⚡</span>
          <span>⌛</span>
          <span>🗓</span>
          <span>❔</span>
        </div>
      </div>

      <div class="hero-editorial__figure float-figure">
        <div class="hero-editorial__figure-body"></div>
        <div class="hero-editorial__figure-head"></div>
        <div class="hero-editorial__figure-glow"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-editorial {
    position: relative;
    overflow: hidden;
    min-height: 64vh;
    background: #120914;
    color: white;
    isolation: isolate;
  }

  .hero-editorial__bg-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top left, rgba(196, 181, 253, 0.22), transparent 28%),
      radial-gradient(circle at top right, rgba(139, 92, 246, 0.24), transparent 24%),
      linear-gradient(135deg, #1b1022 0%, #2b1241 38%, #5b21b6 72%, #7c3aed 100%);
    animation: bgShift 18s ease-in-out infinite alternate;
  }

  .hero-editorial__bg-grid {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.65), rgba(0,0,0,0.15));
  }

  .hero-editorial__blob {
    position: absolute;
    border-radius: 999px;
    filter: blur(60px);
    animation: blobFloat 10s ease-in-out infinite alternate;
  }

  .hero-editorial__blob--left {
    left: -2rem;
    top: 4rem;
    width: 12rem;
    height: 12rem;
    background: rgba(59, 7, 100, 0.55);
  }

  .hero-editorial__blob--top-right {
    top: 3rem;
    right: 0;
    width: 14rem;
    height: 14rem;
    background: rgba(167, 139, 250, 0.30);
    animation-duration: 14s;
  }

  .hero-editorial__blob--bottom-right {
    right: 1rem;
    bottom: 0;
    width: 12rem;
    height: 12rem;
    background: rgba(109, 40, 217, 0.40);
    animation-duration: 12s;
  }

  .hero-editorial__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.95fr 0.85fr;
    align-items: end;
    gap: 1.5rem;
    min-height: 64vh;
    padding-top: 1.75rem;
    padding-bottom: 1.75rem;
  }

  .hero-editorial__content {
    max-width: 30rem;
    padding-bottom: 0.5rem;
  }

  .hero-editorial__badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.08);
    padding: 0.6rem 0.95rem;
    font-size: 0.78rem;
    line-height: 1;
    color: rgba(255,255,255,0.92);
    backdrop-filter: blur(10px);
    margin-bottom: 1rem;
    text-transform: lowercase;
  }

  .hero-editorial__title {
    max-width: 7ch;
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 4.4rem);
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .hero-editorial__subtitle {
    margin-top: 0.9rem;
    max-width: 28rem;
    font-size: clamp(1rem, 1.3vw, 1.35rem);
    font-weight: 700;
    line-height: 1.12;
    color: rgba(255,255,255,0.92);
  }

  .hero-editorial__meta {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: rgba(255,255,255,0.82);
  }

  .hero-editorial__actions {
    margin-top: 1rem;
  }

  .hero-editorial__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-width: 2px;
    background: rgba(0, 0, 0, 0.30);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .hero-editorial__art {
    position: relative;
    min-height: 24rem;
    display: none;
  }

  .hero-editorial__clock {
    position: absolute;
    right: 1rem;
    top: 0.5rem;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 999px;
    background: #ede9fe;
    color: #2e1065;
    box-shadow: 0 18px 32px rgba(0,0,0,0.24);
  }

  .hero-editorial__clock-face {
    position: absolute;
    inset: 0.55rem;
    border-radius: 999px;
    border: 2px solid rgba(46, 16, 101, 0.35);
  }

  .hero-editorial__clock-hand {
    position: absolute;
    left: 50%;
    top: 50%;
    background: #2e1065;
    transform-origin: center;
  }

  .hero-editorial__clock-hand--horizontal {
    width: 1.8rem;
    height: 2px;
    transform: translate(-50%, -50%);
  }

  .hero-editorial__clock-hand--diagonal {
    width: 2px;
    height: 1.8rem;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .hero-editorial__cloud {
    position: absolute;
    left: 1.5rem;
    top: 6rem;
    width: 6rem;
    height: 6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(16, 8, 24, 0.88);
    color: #f5b4ff;
    font-size: 2.2rem;
    box-shadow: 0 18px 32px rgba(0,0,0,0.22);
  }

  .hero-editorial__icons {
    position: absolute;
    top: 3rem;
    right: 0;
    width: 11rem;
    height: 11rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(36, 11, 54, 0.92);
    box-shadow: 0 20px 36px rgba(0,0,0,0.24);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .hero-editorial__icons-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
    font-size: 1.15rem;
    color: #f3e8ff;
    text-align: center;
  }

  .hero-editorial__figure {
    position: absolute;
    right: 1.25rem;
    bottom: 0;
    width: 11rem;
    height: 14rem;
  }

  .hero-editorial__figure-body {
    position: absolute;
    bottom: 0;
    width: 8.8rem;
    height: 11.5rem;
    border-radius: 6rem 6rem 1.5rem 1.5rem;
    background: rgba(71, 40, 82, 0.95);
  }

  .hero-editorial__figure-head {
    position: absolute;
    left: 1.2rem;
    bottom: 4.8rem;
    width: 6.8rem;
    height: 6.8rem;
    border-radius: 999px;
    background: #e3a0cb;
    z-index: 2;
  }

  .hero-editorial__figure-glow {
    position: absolute;
    left: 2.2rem;
    bottom: 5.8rem;
    width: 5rem;
    height: 5rem;
    border-radius: 999px;
    background: rgba(192, 132, 252, 0.45);
    filter: blur(16px);
    z-index: 1;
  }

  .float-slow {
    animation: floatSlow 7s ease-in-out infinite alternate;
  }

  .float-medium {
    animation: floatMedium 6.5s ease-in-out infinite alternate;
  }

  .float-soft {
    animation: floatSoft 8.5s ease-in-out infinite alternate;
  }

  .float-figure {
    animation: figureFloat 9s ease-in-out infinite alternate;
  }

  @keyframes bgShift {
    from {
      transform: scale(1) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.02) translate3d(-0.5%, 0.5%, 0);
    }
  }

  @keyframes blobFloat {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0.5rem, -0.5rem, 0);
    }
  }

  @keyframes floatSlow {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-6px);
    }
  }

  @keyframes floatMedium {
    from {
      transform: translateY(0) translateX(0);
    }
    to {
      transform: translateY(6px) translateX(-5px);
    }
  }

  @keyframes floatSoft {
    from {
      transform: translateY(0) scale(1);
    }
    to {
      transform: translateY(-5px) scale(1.015);
    }
  }

  @keyframes figureFloat {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-8px);
    }
  }

  @media (min-width: 1024px) {
    .hero-editorial__art {
      display: block;
    }
  }

  @media (max-width: 1023px) {
    .hero-editorial {
      min-height: 60vh;
    }

    .hero-editorial__inner {
      grid-template-columns: 1fr;
      min-height: 60vh;
    }

    .hero-editorial__content {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .hero-editorial__title {
      font-size: clamp(2.2rem, 13vw, 3.6rem);
    }

    .hero-editorial__subtitle {
      font-size: 1rem;
    }

    .hero-editorial__badge {
      margin-bottom: 0.9rem;
      padding: 0.65rem 0.9rem;
      font-size: 0.76rem;
    }
  }
</style>