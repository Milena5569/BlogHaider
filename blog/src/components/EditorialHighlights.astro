---
interface Props {
  posts?: any[];
}

const { posts = [] } = Astro.props;

const leadPost = posts[1] || posts[0] || null;
const secondaryPosts = posts.slice(2, 5);

const getCover = (post: any) => {
  if (typeof post?.coverImage === "object" && post?.coverImage?.url) {
    return `${(import.meta.env.PUBLIC_PAYLOAD_URL || "http://localhost:3000").replace(/\/$/, "")}${post.coverImage.url}`;
  }
  return "/images/placeholder.png";
};

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString("pt-BR");
---

<section class="editorial-highlights">
  <div class="editorial-highlights__bg">
    <div class="editorial-highlights__decor editorial-highlights__decor--sleep">😴</div>
    <div class="editorial-highlights__decor editorial-highlights__decor--music">♪</div>
    <div class="editorial-highlights__decor editorial-highlights__decor--clock">◔</div>
    <div class="editorial-highlights__decor editorial-highlights__decor--bubble">💬</div>
  </div>

  <div class="container editorial-highlights__container">
    <div class="editorial-highlights__intro">
      <p class="editorial-highlights__eyebrow">Features and comment</p>
      <h2 class="editorial-highlights__title editorial-title">Destaques editoriais</h2>
      <p class="editorial-highlights__subtitle editorial-subtitle">
        Jornalismo original sobre TDAH, ciência, diagnóstico, rotina e funcionamento mental.
      </p>
    </div>

    {leadPost && (
      <article class="lead-card zoom-hover">
        <div class="lead-card__content">
          <p class="lead-card__label">FEATURE</p>
          <h3 class="lead-card__title">
            <a href={`/post/${leadPost.slug}`}>{leadPost.title}</a>
          </h3>
          <p class="lead-card__excerpt">
            {leadPost.excerpt || "Uma leitura em destaque sobre TDAH, cotidiano, ciência e caminhos práticos."}
          </p>
          {leadPost.publishedDate && (
            <p class="lead-card__date">{formatDate(leadPost.publishedDate)}</p>
          )}
        </div>

        <a href={`/post/${leadPost.slug}`} class="lead-card__media">
          <img src={getCover(leadPost)} alt={leadPost.title} />
        </a>
      </article>
    )}

    {secondaryPosts.length > 0 && (
      <div class="editorial-grid">
        {secondaryPosts.map((post: any) => (
          <article class="mini-card zoom-hover">
            <a href={`/post/${post.slug}`} class="mini-card__image">
              <img src={getCover(post)} alt={post.title} />
            </a>

            <div class="mini-card__content">
              <p class="mini-card__label">FEATURE</p>
              <h3 class="mini-card__title">
                <a href={`/post/${post.slug}`}>{post.title}</a>
              </h3>
              <p class="mini-card__excerpt">
                {post.excerpt || "Conteúdo editorial sobre TDAH, rotina e saúde mental."}
              </p>
              {post.publishedDate && (
                <p class="mini-card__date">{formatDate(post.publishedDate)}</p>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .editorial-highlights {
    position: relative;
    overflow: hidden;
    padding: 72px 0 88px;
    background:
      radial-gradient(circle at top left, rgba(196, 181, 253, 0.22), transparent 28%),
      radial-gradient(circle at top right, rgba(139, 92, 246, 0.24), transparent 24%),
      linear-gradient(135deg, #1b1022 0%, #2b1241 38%, #5b21b6 72%, #7c3aed 100%);
  }

  .editorial-highlights__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .editorial-highlights__decor {
    position: absolute;
    font-size: clamp(2.2rem, 5vw, 4rem);
    opacity: 0.7;
    filter: drop-shadow(0 10px 18px rgba(0,0,0,0.2));
    animation: floatDecor 8s ease-in-out infinite alternate;
  }

  .editorial-highlights__decor--sleep {
    left: 3%;
    top: 18%;
    color: #d05ca0;
  }

  .editorial-highlights__decor--music {
    left: 5%;
    top: 2%;
    color: #800591;
    animation-duration: 10s;
  }

  .editorial-highlights__decor--clock {
    right: 4%;
    top: 16%;
    color: #f5f5f4;
    animation-duration: 11s;
  }

  .editorial-highlights__decor--bubble {
    left: 1%;
    bottom: 18%;
    color: #ffffff;
    animation-duration: 9s;
  }

  .editorial-highlights__container {
    position: relative;
    z-index: 2;
  }

  .editorial-highlights__intro {
    text-align: center;
    margin: 0 auto 40px;
    max-width: 860px;
  }

  .editorial-highlights__eyebrow {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #f6f1f1;
  }

  .editorial-highlights__title {
    margin: 0 0 16px;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 0.95;
    color: #f8f3f2;
  }

  .editorial-highlights__subtitle {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.8rem);
    color: rgba(255,255,255,0.92);
  }

  .lead-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background:#190629;
    margin-bottom: 28px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: var(--shadow);
  }

  .lead-card__content {
    padding: 34px 34px 30px;
    color: #f6f1f1;
  }

  .lead-card__label,
  .mini-card__label {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.92);
  }

  .lead-card__title,
  .mini-card__title {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    line-height: 1;
    font-weight: 700;
  }

  .lead-card__title {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .lead-card__title a,
  .mini-card__title a {
    text-decoration: none;
    color: inherit;
  }

  .lead-card__excerpt,
  .mini-card__excerpt {
    margin: 0 0 18px;
    font-size: 1.05rem;
    line-height: 1.45;
    color: rgba(255,255,255,0.94);
  }

  .lead-card__date,
  .mini-card__date {
    margin: 0;
    font-size: 1rem;
    color: rgba(255,255,255,0.9);
  }

  .lead-card__media {
    display: block;
    min-height: 100%;
  }

  .lead-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
  }

  .mini-card {
    background: #0f6a60;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: var(--shadow-soft);
  }

  .mini-card__image {
    display: block;
    aspect-ratio: 4 / 3;
  }

  .mini-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mini-card__content {
    padding: 24px 20px 22px;
    color: #f6f1f1;
  }

  .mini-card__title {
    font-size: clamp(1.8rem, 2.4vw, 2.5rem);
  }

  @keyframes floatDecor {
    from {
      transform: translateY(0px) rotate(0deg);
    }
    to {
      transform: translateY(-8px) rotate(3deg);
    }
  }

  @media (max-width: 980px) {
    .lead-card {
      grid-template-columns: 1fr;
    }

    .editorial-grid {
      grid-template-columns: 1fr;
    }
  }
</style>