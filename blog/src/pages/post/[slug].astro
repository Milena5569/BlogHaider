---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import TagList from "../../components/TagList.astro";
import LikeButton from "../../components/LikeButton.jsx";
import CommentSection from "../../components/CommentSection.jsx";
import PostViewTracker from "../../components/PostViewTracker.jsx";
import { getPosts, getPostBySlug } from "../../lib/api.js";

export async function getStaticPaths() {
  const posts: any[] = await getPosts();

  return posts
    .filter((post: any) => post?.slug)
    .map((post: any) => ({
      params: { slug: post.slug },
    }));
}

const { slug } = Astro.params;
const post: any = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect("/404");
}

const authorName =
  typeof post.author === "object" && post.author?.name ? post.author.name : "Autor";

const authorBio =
  typeof post.author === "object" && post.author?.bio ? post.author.bio : "";

const tagNames: string[] = Array.isArray(post.tags)
  ? post.tags.map((tag: any) =>
      typeof tag === "object" && tag?.name ? tag.name : String(tag)
    )
  : [];

const coverImageUrl =
  typeof post.coverImage === "object" && post.coverImage?.url
    ? `${(import.meta.env.PUBLIC_PAYLOAD_URL || "http://localhost:3000").replace(/\/$/, "")}${post.coverImage.url}`
    : "/images/placeholder.png";

const publishedDate =
  post?.publishedDate
    ? new Date(post.publishedDate).toLocaleDateString("pt-BR")
    : null;

const content =
  post?.content?.root?.children
    ?.map((block: any) =>
      block?.children?.map((child: any) => child?.text || "").join("") || ""
    )
    .filter(Boolean)
    .join("\n\n") || "";
---

<BaseLayout title={post.title}>
  <article class="post-page">
    <section class="post-hero">
      <div class="container post-hero__grid">
        <div class="post-hero__content">
          <p class="post-hero__eyebrow">Artigo</p>
          <h1 class="post-hero__title editorial-title">{post.title}</h1>

          <div class="post-hero__meta">
            {publishedDate && <span>{publishedDate}</span>}
            <span>•</span>
            <span>{authorName}</span>
          </div>
        </div>

        <div class="post-hero__image-wrap">
          <img src={coverImageUrl} alt={post.title} class="post-hero__image" />
        </div>
      </div>
    </section>

    <section class="post-body section-spacing">
      <div class="container post-body__grid">
        <div class="post-body__main">
          <div class="post-body__content panel">
            <div class="post-prose">
              {content || "Conteúdo não disponível."}
            </div>
          </div>

          {tagNames.length > 0 && (
            <div class="post-body__tags panel">
              <TagList tags={tagNames} />
            </div>
          )}

          <div class="post-body__interactions panel">
            <LikeButton slug={post.slug} client:load />
          </div>

          <div class="post-body__comments panel">
            <CommentSection slug={post.slug} client:load />
          </div>

          <PostViewTracker slug={post.slug} client:load />
        </div>

        <aside class="post-body__sidebar">
          <div class="panel post-body__author-panel">
            <AuthorCard name={authorName} bio={authorBio} />
          </div>
        </aside>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .post-hero {
    padding: 42px 0 28px;
    background:
      radial-gradient(circle at top right, rgba(138, 92, 246, 0.18), transparent 26%),
      linear-gradient(180deg, rgba(19, 10, 28, 0.92), rgba(11, 7, 18, 0.98));
  }

  .post-hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 28px;
    align-items: end;
  }

  .post-hero__eyebrow {
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--lilac);
  }

  .post-hero__title {
    margin: 0 0 16px;
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    line-height: 0.94;
  }

  .post-hero__meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    color: var(--text-soft);
    font-weight: 600;
  }

  .post-hero__image-wrap {
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .post-hero__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .post-body__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 28px;
    align-items: start;
  }

  .post-body__main {
    display: grid;
    gap: 20px;
  }

  .post-body__content,
  .post-body__tags,
  .post-body__interactions,
  .post-body__comments,
  .post-body__author-panel {
    padding: 22px;
  }

  .post-prose {
    white-space: pre-line;
    line-height: 1.75;
    font-size: 1.08rem;
    color: var(--text-soft);
  }

  @media (max-width: 980px) {
    .post-hero__grid,
    .post-body__grid {
      grid-template-columns: 1fr;
    }
  }
</style>