---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import TagList from "../../components/TagList.astro";
import LikeButton from "../../components/LikeButton.jsx";
import CommentSection from "../../components/CommentSection.jsx";
import PostViewTracker from "../../components/PostViewTracker.jsx";
import { getPosts, getPostBySlug } from "../../lib/api.js";

export async function getStaticPaths() {
  const posts: any[] = await getPosts();

  return posts
    .filter((post: any) => post?.slug)
    .map((post: any) => ({
      params: { slug: post.slug },
    }));
}

const { slug } = Astro.params;

const post: any = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect("/404");
}

const authorName =
  typeof post.author === "object" && post.author?.name
    ? post.author.name
    : "Autor";

const authorBio =
  typeof post.author === "object" && post.author?.bio
    ? post.author.bio
    : "";

const authorSlug =
  typeof post.author === "object" && post.author?.slug
    ? post.author.slug
    : null;

const categoryName =
  typeof post.category === "object" && post.category?.name
    ? post.category.name
    : "Sem categoria";

const categorySlug =
  typeof post.category === "object" && post.category?.slug
    ? post.category.slug
    : null;

const tagNames: string[] = Array.isArray(post.tags)
  ? post.tags.map((tag: any) =>
      typeof tag === "object" && tag?.name ? tag.name : String(tag)
    )
  : [];

const coverImageUrl =
  typeof post.coverImage === "object" && post.coverImage?.url
    ? `${(import.meta.env.PUBLIC_PAYLOAD_URL || "http://localhost:3000").replace(/\/$/, "")}${post.coverImage.url}`
    : null;

const publishedDate =
  post?.publishedDate
    ? new Date(post.publishedDate).toLocaleDateString("pt-BR")
    : null;

const content =
  post?.content?.root?.children
    ?.map((block: any) =>
      block?.children?.map((child: any) => child?.text || "").join("") || ""
    )
    .filter(Boolean)
    .join("\n\n") || "";
---

<BaseLayout title={post.title}>
  <article class="max-w-3xl mx-auto">

    <h1 class="text-3xl font-bold mb-4">{post.title}</h1>

    <div class="text-sm text-gray-600 mb-6 space-y-1">
      {publishedDate && <p><strong>Publicado em:</strong> {publishedDate}</p>}

      <p>
        <strong>Autor:</strong>{" "}
        {authorSlug ? <a href={`/autor/${authorSlug}`}>{authorName}</a> : authorName}
      </p>

      <p>
        <strong>Categoria:</strong>{" "}
        {categorySlug ? (
          <a href={`/categoria/${categorySlug}`}>{categoryName}</a>
        ) : (
          categoryName
        )}
      </p>
    </div>

    {coverImageUrl && (
      <img
        src={coverImageUrl}
        alt={post.title}
        class="w-full h-auto rounded-lg mb-6"
      />
    )}

    <div class="prose max-w-none mb-6 whitespace-pre-line">
      {content || "Conteúdo não disponível."}
    </div>

    {tagNames.length > 0 && <TagList tags={tagNames} />}

    <div class="mt-8">
      <AuthorCard name={authorName} bio={authorBio} />
    </div>

    <div class="mt-8 space-y-6">
      <LikeButton slug={post.slug} client:load />
      <CommentSection slug={post.slug} client:load />
      <PostViewTracker slug={post.slug} client:load />
    </div>

  </article>
</BaseLayout>