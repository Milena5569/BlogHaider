---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTags, getTagBySlug, getPosts } from "../../lib/api.js";

export async function getStaticPaths() {
  const tags: any[] = await getTags();

  return tags
    .filter((tag: any) => tag?.slug)
    .map((tag: any) => ({
      params: { slug: tag.slug },
    }));
}

const { slug } = Astro.params;

const tag: any = await getTagBySlug(slug);

if (!tag) {
  return Astro.redirect("/404");
}

const posts: any[] = await getPosts();

const filteredPosts = posts.filter((post: any) => {
  if (!Array.isArray(post?.tags)) return false;

  return post.tags.some((item: any) => {
    if (typeof item === "object") {
      return item.slug === slug;
    }

    return false;
  });
});
---

<BaseLayout title={`Tag: ${tag.name}`}>
  <section class="max-w-3xl mx-auto">

    <h1 class="text-3xl font-bold mb-6">
      Tag: {tag.name}
    </h1>

    {filteredPosts.length === 0 ? (
      <p>Nenhum post encontrado com esta tag.</p>
    ) : (
      <ul class="space-y-3">
        {filteredPosts.map((post: any) => (
          <li>
            <a href={`/post/${post.slug}`}>
              {post.title}
            </a>
          </li>
        ))}
      </ul>
    )}

  </section>
</BaseLayout>