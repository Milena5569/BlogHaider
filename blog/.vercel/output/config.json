{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/autor/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/categoria/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/post/PostCard/?$",
			"dest": "_render"
		},
		{
			"src": "^/post/PostContent/?$",
			"dest": "_render"
		},
		{
			"src": "^/post/PostMeta/?$",
			"dest": "_render"
		},
		{
			"src": "^/post/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/tag/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}